# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
LLM_BASE_URL=https://api.groq.com/openai/v1
# Set true for offline/dev without calling Groq
USE_MOCK_LLM=false

# Recommendation
TOP_K=5
MAX_CANDIDATES=25

# Budget bands (percentiles of dataset cost)
BUDGET_LOW_PERCENTILE=33
BUDGET_HIGH_PERCENTILE=66

# Dataset
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation
HF_DATASET_SPLIT=train
DATA_CACHE_PATH=data/restaurants.parquet

# Comma-separated browser origins allowed to call the API (local + Vercel)
# Example production:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
